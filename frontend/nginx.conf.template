server {
  listen ${PORT};
  listen [::]:${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 12m;   # upload de documentos: 10 MB no backend + margem do multipart

  # __RESOLVER__ é trocado pelo DNS do ambiente no start (30-resolver.sh);
  # com proxy_pass em variável, o nginx re-resolve o backend a cada requisição —
  # necessário porque o IP interno muda a cada redeploy no Railway
  resolver __RESOLVER__ valid=10s;

  location /api/ {
    set $api_upstream ${BACKEND_URL};
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 120s;
  }

  # Bundles têm hash no nome: podem ficar em cache por muito tempo. O index.html
  # não: sempre revalida, para uma nova versão aparecer com um simples recarregar
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
